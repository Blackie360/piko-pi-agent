# Receiver-only activation (still off); systemd credentials described in WHATSAPP.md.
PI_WHATSAPP_PROCESSING_ENABLED=0
PI_WHATSAPP_CONNECTED_NUMBER=REPLACE_CONNECTED_INTERNATIONAL_DIGITS

# Explicit one-use command approvals in WhatsApp; never automatic shell execution.
PI_WHATSAPP_COMMAND_APPROVALS=0

