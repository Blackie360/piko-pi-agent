# Template only. Export values explicitly; the app does not auto-load .env.
# Exact HTTPS origins, comma-separated. Replace before deploying.
PI_AGENT_ALLOWED_ORIGINS=https://piko.example.com
# Optional absolute private paths; omit to use repository-root data/ and ~/piko-workspace.
# PI_AGENT_DATA=/absolute/private/path/piko-data
# PI_AGENT_WORKSPACE=/absolute/path/piko-workspace
# Optional WhatsApp adapter: disabled until your provider contract is verified.
PI_WHATSAPP_ENABLED=0
PI_WHATSAPP_VERIFIED_RELAY=0
PI_WHATSAPP_INSTANCE=REPLACE_INSTANCE_ID
PI_WHATSAPP_OWNERS=REPLACE_OWNER_INTERNATIONAL_DIGITS
PI_WHATSAPP_COMMAND_APPROVALS=0
# Separate Python receiver remains disabled.
PI_WHATSAPP_PROCESSING_ENABLED=0
PI_WHATSAPP_CONNECTED_NUMBER=REPLACE_CONNECTED_INTERNATIONAL_DIGITS
# Non-systemd adapter development ONLY. Receiver requires systemd credentials.
# When CREDENTIALS_DIRECTORY is set, missing credential mounts fail closed.
# PI_WHATSAPP_RELAY_KEY='<REPLACE_WITH_DEDICATED_RANDOM_SECRET_AT_LEAST_32_BYTES>'
# PI_WHATSAPP_API_KEY='<REPLACE_WITH_INSTANCE_BEARER_KEY>'
